# Portfolio Environment Variables

# Optional: Custom Contact Endpoint (e.g., https://formspree.io/f/your_form_id or https://api.web3forms.com/submit)
# If left unset, submissions default to the built-in serverless endpoint: /api/contact
# VITE_CONTACT_ENDPOINT=

# Server-Side Configuration (For Vercel / serverless deployments)
# NEVER prefix secret keys with VITE_
# Set these in your Vercel project dashboard under Settings -> Environment Variables:
# RESEND_API_KEY=re_123456789
# CONTACT_NOTIFICATION_EMAIL=yuvraj925686@gmail.com
# RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
